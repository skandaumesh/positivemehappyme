# Copy to .env.local for local development, and add the same keys in your
# host's dashboard (Vercel → Project → Settings → Environment Variables).

# Supabase → Project Settings → API (or "API Keys")
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# The *secret* / service_role key. Server-only — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# Optional: override the UPI ID / payee name (defaults live in lib/site.ts).
# The QR on the site is generated with the order total filled in.
NEXT_PUBLIC_UPI_ID=8147215288@pthdfc
NEXT_PUBLIC_UPI_NAME=NEHA N LAL

# Optional contact details (shown in the footer / thank-you screen).
# WhatsApp: digits with country code, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=nehalal18@gmail.com
